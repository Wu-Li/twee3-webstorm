<idea-plugin>
    <id>twee.twee3-webstorm</id>
    <name>Twee3</name>
    <vendor url="https://github.com/Wu-Li/twee3-webstorm">Wu-Li</vendor>
    <description><![CDATA[
        <p>Native Twee and Harlowe 3 support for WebStorm, under development.</p>
        <p>Includes structural Twee support, Harlowe 3 highlighting, inherited checks and project check settings, scoped passage navigation and a Passages window with tag editing, static Find Usages and hierarchy views. Includes Tweego HTML build and browser run integration; native verification is pending.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>JavaScript</depends>
    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="twee.run.TweegoConfigurationType"/>
        <toolWindow id="Passages" anchor="right" factoryClass="twee.passages.PassagesToolWindowFactory"/>
        <fileType name="Twee" language="Twee" implementationClass="twee.language.TweeFileType"
                  fieldName="INSTANCE" extensions="twee;tw"/>
        <lang.parserDefinition language="Twee" implementationClass="twee.parser.TweeParserDefinition"/>
        <lang.syntaxHighlighterFactory language="Twee" implementationClass="twee.highlighting.TweeSyntaxHighlighterFactory"/>
        <annotator language="Twee" implementationClass="twee.highlighting.TweeHeaderAnnotator"/>
        <colorSettingsPage implementation="twee.highlighting.TweeColorSettingsPage"/>
        <annotator language="Twee" implementationClass="twee.inspections.TweeChecksAnnotator"/>
        <projectConfigurable id="twee.checks" displayName="Twee checks" parentId="language"
                             instance="twee.settings.TweeChecksConfigurable"/>
        <notificationGroup id="Twee StoryData" displayType="BALLOON" isLogByDefault="true"/>
        <projectConfigurable id="twee.stories" displayName="Twee stories" parentId="language"
                             instance="twee.scope.StoryConfigurable"/>
        <postStartupActivity implementation="twee.scope.StoryStartup"/>
        <!-- Kotlin object: use eager initialization; externalIdPrefix requires an interface. -->
        <stubElementTypeHolder class="twee.parser.TweeTypes"/>
        <stubIndex implementation="twee.index.TweePassageNameIndex"/>
        <stubIndex implementation="twee.index.TweePassageTagIndex"/>
        <stubIndex implementation="twee.index.TweeAllPassagesIndex"/>
        <fileBasedIndex implementation="twee.relations.RelationIndex"/>
        <lang.findUsagesProvider language="Twee" implementationClass="twee.usages.TweeFindUsagesProvider"/>
        <lang.targetElementEvaluator language="Twee" implementationClass="twee.usages.TweeTargetEvaluator"/>
        <findUsagesHandlerFactory implementation="twee.usages.TweeFindUsagesHandlerFactory"/>
        <referencesSearch implementation="twee.usages.TweeReferencesSearch"/>
        <elementDescriptionProvider implementation="twee.usages.TweeElementDescriptionProvider"/>
        <usageTypeProvider implementation="twee.usages.TweeUsageTypeProvider"/>
        <readWriteAccessDetector implementation="twee.usages.TweeReadWriteAccessDetector"/>
        <callHierarchyProvider language="Twee" implementationClass="twee.hierarchy.TweeHierarchyProvider"/>
    </extensions>
    <actions>
        <action id="Twee.BuildHtml" class="twee.run.BuildHtmlAction" text="Build Twee HTML"
                description="Compile the selected Twee story without opening a browser">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
